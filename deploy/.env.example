# ============================================================
# 弦歌 · 环境变量模板
# 用法：cp .env.example .env 然后填好每一项；.env 已被 gitignore，绝不提交
# ============================================================

# --- 数据库 ---
# root 密码：务必换成强随机串（生成：openssl rand -base64 24）
MYSQL_ROOT_PASSWORD=change-me-please
MYSQL_DB=yuetin

# --- 登录令牌签名密钥 ---
# 生成：openssl rand -base64 48
# 这是签发登录 JWT 的钥匙，泄露=任何人可伪造登录，必须唯一且保密
JWT_SECRET=

# --- AI 能力 ---
# DeepSeek 开放平台申请：https://platform.deepseek.com（问诗/读诗谱曲用）
# 不填则问诗不可用、谱曲降级为规则提示词
DEEPSEEK_API_KEY=

# --- 域名（仅文档记录用，nginx.conf 里手改 server_name）---
# DOMAIN=xiangets.com
